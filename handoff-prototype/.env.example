# Optional. Without these, realtime falls back to BroadcastChannel
# (works between tabs/windows of the same browser on one machine).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Base URL encoded in the pairing QR code. Defaults to the origin
# the display page is opened from. Set this to your LAN address or tunnel URL
# (e.g. http://192.168.1.20:3000) when the display runs on "localhost".
NEXT_PUBLIC_APP_URL=
